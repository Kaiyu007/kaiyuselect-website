---
import { websitePackages, pricingDisclosure, packageSubject, businessOptions } from '../data/website-packages.js';
import { websiteEnquiry } from '../data/web-demos';
const groups = [
  { title: 'Essential Websites', description: 'A clear online presence, without a content management backend.', packages: websitePackages.slice(0, 2) },
  { title: 'Content & Business Websites', description: 'Manage agreed content, publish new entries and choose the functionality your business needs.', packages: websitePackages.slice(2) },
];
const faqs = [
  ['Can I edit the website myself?', 'The three content-managed packages let you edit agreed text, images, prices and contact details through a backend. One-Page Website and Essential Business Website do not include a content management backend. Major layout changes, new features and additional integrations are separately quoted.'],
  ['How are pages and content entries counted?', 'Standard pages, initial case-study/article entries, products/SKUs and booking configuration are separate counts, with no item counted twice. Reusable case-study and article detail pages use shared templates. The 10 / 15 / 20 entry limits cover initial case-study and article content only, not product uploads or booking services. Plus and Advanced combine both content types within one limit. Ongoing publishing stays within the agreed content types and platform capabilities.'],
  ['Who provides the content?', 'You provide the business information, text, images and any product information or service rules needed. Content preparation means working from those materials within the stated English word and initial-entry limits. It does not mean unrestricted content creation. Extra content, photography or new copywriting scope is quoted separately.'],
  ['What is a consolidated revision round?', 'One revision round is one consolidated set of feedback covering reasonable adjustments within the approved design and agreed scope. Professional Showcase and Business Plus include two rounds; Business Advanced includes three. For the two essential packages, revision arrangements are confirmed in the quotation. Major redesigns, new functionality and additional pages require a separate quotation.'],
  ['Do I need a monthly maintenance plan?', 'There is no compulsory monthly maintenance fee from Kaiyu Select. Ongoing hosting, domain renewals, third-party subscriptions and platform maintenance remain separate responsibilities. Future work and optional maintenance services are quoted separately.'],
  ['Which package should I choose?', 'Choose an essential website for a simple presence without a content backend, Professional Showcase to manage and publish one content type, or Business Plus / Business Advanced for one standard / expanded business function. If you need both booking and ecommerce, or a more complex workflow, request a tailored quotation.'],
];
---
<section class="section pricing-section" id="pricing" aria-labelledby="pricing-title">
  <div class="shell">
    <div class="section-heading split pricing-heading">
      <div><p class="eyebrow"><span></span>Scope first. Clear pricing.</p><h2 id="pricing-title">Website Packages<br />& Pricing</h2></div>
      <div><p class="section-intro">Clear packages for different business needs. From a simple online presence to a content-managed website with booking or online store functionality.</p><p class="price-basis">These are the actual package prices for the stated scopes.</p></div>
    </div>
    <p class="pricing-disclosure">{pricingDisclosure}</p>
    <nav class="section-nav pricing-nav" aria-label="Website pricing sections"><a href="#packages">Packages <span aria-hidden="true">↓</span></a><a href="#package-comparison">Full scope <span aria-hidden="true">↓</span></a><a href="#business-functions">Booking & store <span aria-hidden="true">↓</span></a><a href="#pricing-costs">Other costs <span aria-hidden="true">↓</span></a><a href="#pricing-faq">FAQs <span aria-hidden="true">↓</span></a><a href="#live-project">View our work <span aria-hidden="true">↓</span></a></nav>
    <div id="packages" class="package-groups">
      {groups.map(group => <div class="package-group">
        <div class="package-group-heading"><h3>{group.title}</h3><p>{group.description}</p></div>
        <div class:list={['package-grid', { 'essential-grid': group.packages.length === 2 }]}>
          {group.packages.map(pkg => <article class="package-card" aria-labelledby={`package-${pkg.id}`}>
            <p class="package-number">Package {pkg.number}</p>
            <h4 id={`package-${pkg.id}`}>{pkg.name}</h4>
            <p class="package-price">{pkg.price}</p>
            <p class="package-positioning">{pkg.positioning}</p>
            <ul class="package-highlights">{pkg.highlights.map(item => <li>{item}</li>)}</ul>
            <div class="package-actions">
              {pkg.business ? <form action="/contact/" method="get" aria-label={`Enquire about ${pkg.name}`}>
                <input type="hidden" name="type" value="webdesign" />
                <label for={`function-${pkg.id}`}>Choose one {pkg.business.toLowerCase()} option</label>
                <select id={`function-${pkg.id}`} name="subject"><option value={packageSubject(pkg)}>Discuss the option with us</option><option value={packageSubject(pkg, 'Booking')}>Booking</option><option value={packageSubject(pkg, 'Online Store')}>Online Store</option></select>
                <button class="button button-outline" aria-label={`Enquire About This Package — ${pkg.name}`} type="submit">Enquire About This Package</button>
              </form> : <a class="button button-outline" aria-label={`Enquire About This Package — ${pkg.name}`} href={`/contact/?${new URLSearchParams({ type: 'webdesign', subject: packageSubject(pkg) })}`}>Enquire About This Package</a>}
            </div>
          </article>)}
        </div>
      </div>)}
    </div>
    <div class="pricing-block" id="package-comparison">
      <div class="pricing-block-heading"><h3>Compare the full scope</h3><p>Open a package to see every inclusion. Standard pages and reusable content entries are counted separately.</p></div>
      <dl class="content-counts" aria-label="How package scope is counted">
        <div><dt>Standard pages</dt><dd>Standard pages are built around the agreed content structure, design system and normal website components. Advanced custom functionality is outside the fixed package scope unless explicitly included. Case-study and article detail pages use shared templates and do not each count as another standard page.</dd></div>
        <div><dt>Initial content entries</dt><dd>Showcase: up to 10 case studies OR articles. Plus: up to 15 case studies and articles combined. Advanced: up to 20 combined. For example, 8 case studies + 7 articles use 15 entries.</dd></div>
        <div><dt>Products & SKUs</dt><dd>Counted separately from case studies and articles. A product variant needing its own stock management counts as one SKU.</dd></div>
        <div><dt>Booking configuration</dt><dd>Service types and staff are counted separately. Product uploads and booking configuration do not use the initial content entry allowance.</dd></div>
      </dl>
      <p class="counting-note">No item is counted twice across these categories. Editing applies to the agreed fields; Advanced also includes agreed editable content for the chosen business function.</p>
      <div class="pricing-accordions">
        {websitePackages.map(pkg => <details class="pricing-details" id={`scope-${pkg.id}`}>
          <summary><span class="scope-number">{pkg.number}</span><span class="scope-title">{pkg.name}</span><span class="scope-price">{pkg.price}</span><span class="disclosure-toggle" aria-hidden="true"></span></summary>
          <div class="scope-content"><ul>{pkg.scope.map(item => <li>{item}</li>)}</ul>{pkg.business && <p class="scope-note">Booking OR small online store — choose one {pkg.business.toLowerCase()} option. <a href="#business-functions">Compare the business functionality below.</a></p>}</div>
        </details>)}
      </div>
    </div>
    <div class="pricing-block" id="business-functions">
      <div class="pricing-block-heading"><h3>One function, chosen for your business</h3><p>Business Plus includes one standard option. Business Advanced includes one expanded option. Both include a standard enquiry form in addition to the chosen function.</p></div>
      <div class="function-rule"><p>Booking system OR small online store — choose one. Both are not included in a single package.</p><span>Both functions, complex integrations or requirements beyond these limits need a separate quotation.</span></div>
      {businessOptions.map(option => <details class="pricing-details function-details">
        <summary><span class="scope-title">{option.name}</span><span class="function-summary-note">Standard / expanded</span><span class="disclosure-toggle" aria-hidden="true"></span></summary>
        <div class="function-content"><p>{option.description}</p><div class="function-comparison"><div><p class="function-level">Standard · Business Plus · A$1,078</p><ul>{option.standard.map(item => <li>{item}</li>)}</ul></div><div><p class="function-level">Expanded · Business Advanced · A$1,560</p><ul>{option.expanded.map(item => <li>{item}</li>)}</ul></div></div><p class="scope-note">{option.note}</p></div>
      </details>)}
      <p class="function-testing">Both options include reasonable testing of the agreed workflow, including booking confirmations or test orders and relevant notifications. Customers provide product information and service rules, and complete required third-party account verification.</p>
    </div>
    <div class="pricing-block pricing-costs" id="pricing-costs">
      <div><p class="eyebrow">Additional costs & scope</p><h3>Know what sits<br />outside the package.</h3><p>No compulsory monthly maintenance fee from Kaiyu Select. A website may still have ongoing third-party costs.</p></div>
      <div><ul><li>Domain registration is charged separately.</li><li>Hosting fees, where applicable, are separate.</li><li>Paid CMS, booking, ecommerce platform, plugin and subscription fees are separate.</li><li>Payment processing and transaction fees are separate.</li><li>Additional features, pages and content beyond package limits require a separate quote.</li></ul><p class="cost-confirmation">The final project scope, third-party platform suitability, supported features, external fees and required account or payment verification are confirmed in writing before you accept a quotation and before work begins.</p></div>
    </div>
    <div class="pricing-block" id="pricing-faq"><div class="pricing-block-heading"><h3>A few useful answers</h3><p>Editing, content, revisions and ongoing costs.</p></div><div class="pricing-accordions">{faqs.map(([question, answer]) => <details class="pricing-details faq-details"><summary><span class="scope-title">{question}</span><span class="disclosure-toggle" aria-hidden="true"></span></summary><div class="faq-answer"><p>{answer}</p></div></details>)}</div></div>
    <div class="pricing-custom"><div><p class="eyebrow">A tailored quotation</p><h3>Need Something Different?</h3><p>For complex ecommerce, custom integrations, larger service websites, multiple business functions, advanced booking workflows or additional pages and content, let’s agree a scope that fits.</p></div><a class="button" href={websiteEnquiry('a tailored website quotation')}>Discuss Your Website Project <span aria-hidden="true">↗</span></a></div>
  </div>
</section>
<style>
  .content-counts{display:grid;grid-template-columns:1fr 1fr;gap:24px 40px;margin:0 0 20px}.content-counts>div{border-top:1px solid var(--line);padding-top:16px}.content-counts dt{font-size:14px;font-weight:650;color:var(--teal);margin-bottom:8px}.content-counts dd{font-size:14px;color:var(--muted);margin:0}.counting-note{font-size:13px;color:var(--muted);margin:0 0 24px;max-width:920px}@media(max-width:600px){.content-counts{grid-template-columns:1fr;gap:18px}}
  .pricing-section{border-block:1px solid var(--line)}
  .pricing-heading{margin-bottom:24px}.price-basis{font-size:13px;margin:16px 0 0;color:var(--teal);font-weight:650}.pricing-disclosure{max-width:960px;color:var(--muted);font-size:14px;margin:0}.pricing-nav{margin-top:24px;gap:8px 28px}
  .package-groups{margin-top:44px;scroll-margin-top:24px}.package-group+.package-group{margin-top:40px}.package-group-heading{display:flex;justify-content:space-between;align-items:baseline;gap:24px;margin-bottom:20px}.package-group-heading h3{font-size:23px;margin:0;flex-shrink:0}.package-group-heading p{color:var(--muted);font-size:14px;max-width:560px;margin:0}
  .package-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.essential-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.package-card{padding:28px;background:var(--white);border:1px solid var(--line);display:flex;flex-direction:column;min-width:0}.package-number{font:12px ui-monospace,monospace;color:var(--teal);margin:0 0 18px}.package-card h4{font-size:23px;font-weight:600;line-height:1.2;letter-spacing:-.03em;margin:0 0 18px}.package-price{font-size:42px;letter-spacing:-.045em;line-height:1.15;font-weight:550;margin:0 0 20px}.package-positioning{color:var(--muted);font-size:14px;min-height:4.8em;margin-bottom:20px}.essential-grid .package-positioning{min-height:0}.package-highlights{border-top:1px solid var(--line);padding:18px 0 0;list-style:none;margin:0 0 24px;font-size:14px}.package-highlights li{position:relative;padding-left:18px}.package-highlights li::before{content:'—';position:absolute;left:0;color:var(--teal)}.package-highlights li+li{margin-top:9px}.package-actions{margin-top:auto}.package-actions .button{width:100%;padding-inline:12px;font-size:13px}.package-actions label{display:block;font-size:12px;font-weight:650;margin-bottom:8px}.package-actions select{width:100%;min-height:46px;padding:10px 26px 10px 12px;border:1px solid var(--line);border-radius:0;color:var(--ink);background:var(--paper);font-size:13px;margin-bottom:14px}.package-actions select:focus-visible{outline:2px solid var(--teal);outline-offset:3px}
  .pricing-block{padding-top:56px;scroll-margin-top:24px}.pricing-block-heading{display:grid;grid-template-columns:1fr 1fr;gap:40px;margin-bottom:24px;align-items:baseline}.pricing-block h3,.pricing-custom h3{font-size:28px;margin:0}.pricing-block-heading p{font-size:14px;color:var(--muted);margin:0}.pricing-accordions{border-top:1px solid var(--line)}.pricing-details{border-bottom:1px solid var(--line)}.pricing-details summary{display:flex;align-items:center;gap:22px;min-height:72px;padding:18px 4px;list-style:none;cursor:pointer}.pricing-details summary::-webkit-details-marker{display:none}.pricing-details summary:focus-visible{outline-offset:0}.scope-number{font:12px ui-monospace,monospace;color:var(--teal);flex:0 0 24px}.scope-title{font-size:16px;font-weight:600;line-height:1.45}.scope-price{margin-left:auto;font-size:16px;white-space:nowrap}.disclosure-toggle{position:relative;flex:0 0 18px;width:18px;height:18px;margin-left:auto}.scope-price+.disclosure-toggle,.function-summary-note+.disclosure-toggle{margin-left:0}.disclosure-toggle::before,.disclosure-toggle::after{content:'';position:absolute;left:2px;top:8px;width:14px;height:1px;background:var(--teal)}.disclosure-toggle::after{transform:rotate(90deg)}.pricing-details[open]>summary .disclosure-toggle::after{transform:none}.scope-content{padding:12px 46px 24px}.scope-content ul{columns:2;column-gap:56px}.scope-content li{break-inside:avoid}.scope-content ul,.function-content ul,.pricing-costs ul{padding-left:20px;margin:0;font-size:14px}.scope-content li+li,.function-content li+li,.pricing-costs li+li{margin-top:10px}.scope-note{margin:22px 0 0;font-size:13px;color:var(--muted);line-height:1.65}.scope-note a{color:var(--teal);text-underline-offset:3px}
  .function-rule{border-left:3px solid var(--teal);padding:18px 24px;margin-bottom:16px;background:var(--soft)}.function-rule p{font-size:17px;font-weight:600;max-width:760px;line-height:1.5;margin:0 0 8px}.function-rule span{font-size:13px;color:var(--muted)}.function-summary-note{font-size:12px;color:var(--muted);margin-left:auto}.function-content{padding:12px 4px 26px}.function-content>p:first-child{color:var(--muted);font-size:14px;max-width:850px;margin-bottom:24px}.function-comparison{display:grid;grid-template-columns:1fr 1fr;gap:40px}.function-level{font-size:14px;font-weight:650;color:var(--teal);margin-bottom:18px}.function-comparison>div+div{border-left:1px solid var(--line);padding-left:40px}.function-testing{max-width:960px;font-size:13px;color:var(--muted);margin:20px 0 0}
  .pricing-costs{display:grid;grid-template-columns:1fr 1fr;gap:60px}.pricing-costs .eyebrow{font-size:10px}.pricing-costs h3{margin-bottom:20px}.pricing-costs>div>p:not(.eyebrow){font-size:14px;color:var(--muted);max-width:450px}.pricing-costs .cost-confirmation{margin:22px 0 0}.faq-answer{padding:10px 4px 24px;max-width:850px}.faq-answer p{font-size:14px;color:var(--muted);margin:0}.pricing-custom{border-top:1px solid var(--line);margin-top:48px;padding-top:36px;display:grid;grid-template-columns:1fr auto;align-items:center;gap:48px}.pricing-custom .eyebrow{font-size:10px}.pricing-custom h3{margin-bottom:16px}.pricing-custom p:last-child{font-size:14px;color:var(--muted);max-width:700px;margin:0}.pricing-custom .button{gap:16px}
  @media(max-width:1100px){.package-card{padding:24px 20px}.package-grid{gap:14px}.package-card h4{font-size:21px;min-height:2.4em}.package-positioning{min-height:6.4em}.package-group-heading{display:block}.package-group-heading p{margin-top:10px;max-width:none}.package-actions .button{font-size:13px;padding-inline:8px}}
  @media(max-width:850px){.package-grid:not(.essential-grid){grid-template-columns:1fr}.package-grid:not(.essential-grid) .package-card{display:grid;grid-template-columns:1fr 1fr;column-gap:28px}.package-grid:not(.essential-grid) .package-number,.package-grid:not(.essential-grid) h4,.package-grid:not(.essential-grid) .package-price,.package-grid:not(.essential-grid) .package-positioning{grid-column:1}.package-grid:not(.essential-grid) .package-highlights{grid-column:2;grid-row:1 / 4;border-top:0;padding-top:0}.package-grid:not(.essential-grid) .package-actions{grid-column:2;grid-row:4 / 6;align-self:end}.package-card h4,.package-positioning{min-height:0}.package-price{font-size:38px}.pricing-custom{grid-template-columns:1fr;gap:24px}.pricing-custom .button{justify-self:start}.pricing-costs{gap:32px}}
  @media(max-width:600px){.pricing-heading h2{font-size:33px}.pricing-nav{gap:4px 22px}.pricing-disclosure{font-size:13px}.package-groups{margin-top:32px}.package-grid,.essential-grid{grid-template-columns:1fr;gap:16px}.package-grid:not(.essential-grid) .package-card{display:flex}.package-card{padding:24px}.package-number{margin-bottom:14px}.package-card h4{font-size:23px;margin-bottom:14px}.package-price{font-size:40px;margin-bottom:16px}.package-positioning{margin-bottom:18px}.package-highlights,.package-grid:not(.essential-grid) .package-highlights{border-top:1px solid var(--line);padding-top:18px;margin-bottom:20px}.package-actions,.package-grid:not(.essential-grid) .package-actions{align-self:stretch}.package-actions .button{font-size:13px}.package-group+.package-group{margin-top:32px}.package-group-heading h3{font-size:22px}.pricing-block{padding-top:40px}.pricing-block-heading{grid-template-columns:1fr;gap:12px;margin-bottom:20px}.pricing-block h3,.pricing-custom h3{font-size:26px}.pricing-details summary{gap:12px;flex-wrap:wrap;padding-block:18px}.scope-number{flex-basis:20px}.scope-title{font-size:14px;flex:1}.scope-price{font-size:14px}.scope-content{padding:12px 4px 22px}.scope-content ul{columns:1}.function-rule{padding:18px}.function-rule p{font-size:16px}.function-summary-note{display:none}.function-comparison,.pricing-costs{grid-template-columns:1fr;gap:24px}.function-comparison>div+div{border-left:0;border-top:1px solid var(--line);padding:24px 0 0}.pricing-custom{margin-top:40px;padding-top:28px;gap:24px}.pricing-custom .button{width:100%;font-size:12px}}
</style>
