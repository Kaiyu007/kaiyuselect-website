---
import ResponsiveImage from './ResponsiveImage.astro';
import type { Product } from '../data/site';
interface Props extends Product {}
const { id, category, title, description, colour, compatibility, status, image, alt } = Astro.props;
const enquiryUrl = `/contact?${new URLSearchParams({ type: 'product', subject: title, product: id })}`;
---
<article class="product-card" id={id}>
  <div class="product-visual fit-contain"><ResponsiveImage src={image} alt={alt} /></div>
  <div class="product-info">
    <p class="product-category">{category}</p>
    <h3>{title}</h3>
    <p>{description}</p>
    <dl class="product-specs">
      <div><dt>Colour shown</dt><dd>{colour}</dd></div>
      <div><dt>Phone fit</dt><dd>{compatibility || 'Confirm your phone model when enquiring.'}</dd></div>
    </dl>
    <div class="product-card-action">
      <span class="availability-label">{status}</span>
      <a class="text-link" href={enquiryUrl} aria-label={`Enquire about ${title}`}>Enquire about this style <span aria-hidden="true">→</span></a>
    </div>
  </div>
</article>
