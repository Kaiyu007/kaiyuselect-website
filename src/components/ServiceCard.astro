---
import ServiceVisual from './ServiceVisual.astro';

interface Props {
  number: string;
  title: string;
  description: string;
}
const { number, title, description } = Astro.props;
---
<article class="service-card">
  <div class="service-card-top">
    <ServiceVisual number={number} />
    <span class="card-number">{number}</span>
  </div>
  <h3>{title}</h3>
  <p>{description}</p>
</article>
