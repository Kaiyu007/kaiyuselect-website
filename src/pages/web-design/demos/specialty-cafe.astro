---
import DemoLayout from '../../../components/demos/DemoLayout.astro';
import Art from '../../../components/demos/Art.astro';
import LocalEnquiry from '../../../components/demos/LocalEnquiry.astro';
const menu={Coffee:[['The house cup','An espresso-led coffee concept, with milk preferences discussed at the counter.','Coffee menu concept'],['Slow brew','A rotating filter selection presented with simple tasting notes.','Filter menu concept'],['Over ice','A chilled coffee option for a slower afternoon.','Cold drinks concept'],['Something else','Tea and chocolate alternatives, with ingredients to be confirmed.','Other drinks concept']],Breakfast:[['Avocado on toast','Sourdough, avocado and a bright herb finish.','Illustrative dish'],['The morning bowl','A seasonal fruit, yoghurt and granola composition.','Illustrative dish'],['A warm start','Eggs with toast and a simple side.','Illustrative dish'],['From the oven','A pastry selection that changes with the day.','Illustrative dish']],Lunch:[['The garden plate','A seasonal assembly of vegetables and grains.','Illustrative dish'],['A good sandwich','Toasted bread, a considered filling and something crisp.','Illustrative dish'],['Soup & sourdough','A simple warm lunch with bread on the side.','Illustrative dish'],['A small sweet','Something to share, or keep for yourself.','Illustrative dish']]};
---
<DemoLayout slug="specialty-cafe">
  <section class="demo-hero d-shell"><div class="hero-copy"><p class="d-kicker">Coffee · Something seasonal · A moment for you</p><h1>Good mornings<br />start slowly.</h1><p class="d-lead">Pull up a chair. A little warmth, a good cup and a reason to stay a while.</p><div class="d-actions"><a class="d-button" href="#menu">Take a look at the menu ↓</a><a class="d-text-button" href="#reservation">Plan a visit</a></div></div><div class="hero-media"><Art name="cafe-hero" alt="AI-generated concept image of a warm café interior with a coffee and croissant in the foreground" eager sizes="100vw" /><p class="art-caption">An AI-generated café concept, not a real venue</p></div></section>
  <section class="d-section d-shell" id="menu"><div class="cafe-menu"><div><p class="d-kicker">Something for your kind of day</p><h2>The sample menu.</h2><p>Browse a fictional menu direction. A real café would confirm dishes, prices, availability and dietary information.</p><p class="demo-note">No orders are taken. Illustrative ingredients are not allergen advice.</p></div><div data-switcher><div class="filter-buttons" role="group" aria-label="Menu category">{Object.keys(menu).map((c,i)=><button type="button" data-switch={c} aria-pressed={i===0?'true':'false'}>{c}</button>)}</div>{Object.entries(menu).map(([category,entries],i)=><div data-panel={category} hidden={i!==0} class="menu-items" aria-label={`${category} menu`}>{entries.map(([t,p,s])=><article class="menu-item"><h3>{t}</h3><p>{p}</p><span>{s}</span></article>)}</div>)}</div></div></section>
  <section class="d-section d-shell"><div class="d-section-head"><div><p class="d-kicker">The table edit</p><h2>A few little favourites.</h2></div><p>AI-generated concept images explore how a café could present its signature dishes without a crowded menu.</p></div><div class="d-grid-3">{[['cafe-one','The everyday ritual','A warm cup, a quiet corner and no need to rush.'],['cafe-breakfast','Something green','A fresh, colourful direction for the breakfast menu.'],['cafe-pastry','A flaky little pause','A pastry concept for the bakery counter.']].map(([a,t,p])=><article class="cafe-feature"><Art name={a} alt={`AI-generated café concept: ${t}`} /><h3>{t}</h3><p>{p}</p></article>)}</div></section>
  <section class="d-section d-shell d-story" id="story"><div><p class="d-kicker">Our story / A fictional café</p><h2>A small space.<br />A generous welcome.</h2><p class="d-lead">Moss & Mug imagines a neighbourhood café where the everyday feels considered.</p><p>Warm colours, rounded forms and a menu that is easy to browse set a relaxed pace. In a real website, this space would tell the owners’ own story and introduce their people, food and coffee.</p></div><Art name="cafe-interior" alt="AI-generated café seating corner with oak tables and forest green upholstery" /></section>
  <section class="d-section d-shell" id="visit"><div class="contact-strip"><div><p class="d-kicker">Opening hours concept</p><h3>A place in your routine.</h3><ul class="hours"><li><span>Weekdays</span><span>7 am – 3 pm</span></li><li><span>Saturday</span><span>8 am – 2 pm</span></li><li><span>Sunday</span><span>A quiet day off</span></li></ul><p class="demo-note">Sample hours only. This fictional café has no operating location.</p></div><div><p class="d-kicker">Contact & visiting</p><h3>Good information, before you arrive.</h3><p>A real café website would show its verified address, phone number, access details and current opening hours here.</p><a class="d-text-button" href="#reservation">Try the reservation concept ↓</a></div></div></section>
  <section class="d-section d-shell"><LocalEnquiry id="reservation" title="Save a little time to slow down." kind="reservation request" options={['A table for 1–2','A table for 3–4','A table for 5–6','A group enquiry']} /></section>
</DemoLayout>
