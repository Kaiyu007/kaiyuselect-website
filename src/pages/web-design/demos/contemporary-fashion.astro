---
import DemoLayout from '../../../components/demos/DemoLayout.astro';
import Art from '../../../components/demos/Art.astro';
import Catalog from '../../../components/demos/Catalog.astro';
const items=[
{id:'coat',title:'The everyday layer',category:'Outerwear',art:'fashion-one',views:['fashion-two','fashion-three'],description:'An easy, structured layer with generous pockets and a clean front. Choose a colour study to explore the same silhouette in chalk, ink or clay.',facts:'Fictional outerwear concept · Relaxed silhouette'},
{id:'shirt',title:'The studio shirt',category:'Essentials',art:'fashion-four',views:['fashion-shirt-ink','fashion-shirt-clay'],description:'A simple short-sleeve form for the core wardrobe. The colour studies demonstrate how product options could be presented without a checkout.',facts:'Fictional essential concept · Straight silhouette'},
{id:'overshirt',title:'The open overshirt',category:'Outerwear',art:'fashion-overshirt-chalk',views:['fashion-overshirt-ink','fashion-overshirt-clay'],description:'A pared-back overshirt with a defined collar and two front pockets. Part of a fictional wardrobe exploring versatile layers.',facts:'Fictional layering concept · Box silhouette'}];
const looks=[['01 / The quiet uniform','One layer. Many possibilities.','An uncluttered silhouette with room for everyday movement.','fashion-lookbook'],['02 / After hours','A darker point of view.','The same visual language, expressed in a deeper tone.','fashion-editorial-ink'],['03 / Warmer days','A softer kind of structure.','A warm colour study balances the collection’s sharp lines.','fashion-coat-clay']];
---
<DemoLayout slug="contemporary-fashion">
  <section class="demo-hero d-shell"><div class="hero-copy"><div class="fashion-season"><span>COLLECTION / 01</span><span>FICTIONAL EDITION</span></div><h1>Everyday, <br />reimagined.</h1><p class="d-lead">Less noise. More possibility. A wardrobe concept built around useful forms and quiet character.</p><a class="d-button" href="#arrivals">Explore the edit ↗</a></div><div class="hero-media"><Art name="fashion-hero" alt="AI-generated fashion editorial of two fictional adult models in neutral clothing against a stone facade" eager sizes="100vw" /><p class="art-caption">AI-generated campaign / No products for sale</p></div></section>
  <section class="d-section d-shell" id="arrivals"><div class="d-section-head"><div><p class="d-kicker">The edit / New arrivals concept</p><h2>Fewer pieces.<br />More intention.</h2></div><p>Browse the categories, explore a silhouette and switch between three colour studies. All products are fictional.</p></div><Catalog id="fashion" items={items} categories={['Outerwear','Essentials']} colours><button type="button" class="d-text-button" data-open-dialog="size-guide">View the size guide ↗</button></Catalog></section>
  <dialog class="demo-modal" id="size-guide" aria-labelledby="size-guide-title"><button class="d-text-button" type="button" data-close-dialog autofocus>Close ×</button><h2 id="size-guide-title">Sample size guide</h2><p>Illustrative garment measurements only. These are not specifications for an available product.</p><div class="table-scroll"><table class="demo-table"><caption>Sample relaxed top · centimetres</caption><thead><tr><th scope="col">Size</th><th scope="col">Chest width</th><th scope="col">Length</th></tr></thead><tbody><tr><th scope="row">S</th><td>52</td><td>66</td></tr><tr><th scope="row">M</th><td>56</td><td>69</td></tr><tr><th scope="row">L</th><td>60</td><td>72</td></tr></tbody></table></div><p class="demo-note">Chest width is measured flat across the garment. A real size guide would use confirmed product measurements. Press Escape to close.</p></dialog>
  <section class="d-section d-shell" id="lookbook"><div class="d-section-head"><div><p class="d-kicker">A study in everyday dressing</p><h2>The lookbook.</h2></div><p>Three editorial compositions. Move through the edit at your own pace.</p></div><div data-lookbook>{looks.map(([k,t,p,a],i)=><div class="lookbook-slide" data-slide hidden={i!==0}><Art name={a} alt={`Original fashion colour study: ${t}`} /><div><p class="d-kicker">{k}</p><h3>{t}</h3><p>{p}</p><a class="d-text-button" href="#arrivals">Explore the collection ↑</a></div></div>)}<div class="lookbook-controls"><button type="button" data-direction="-1" aria-label="Previous look">←</button><span role="status" data-slide-count>1 / 3</span><button type="button" data-direction="1" aria-label="Next look">→</button></div></div></section>
  <section class="d-section d-shell" id="story"><div class="d-grid-2"><div><p class="d-kicker">The Forme approach / Fictional brand story</p><h2>Clothes as a framework.<br />Style as your own.</h2></div><div><p class="d-lead">Forme imagines a fashion brand that leaves room for the person wearing it.</p><p>Hard rules, oversized typography and restrained colour keep the focus on silhouette. Product information stays close to the images, and every option remains accessible on a small screen.</p><p class="demo-note">This is an original website concept, not an operating label. No claims about fabrics, manufacturing, sustainability or stock are made. There is no shopping cart or payment function.</p></div></div></section>
</DemoLayout>
