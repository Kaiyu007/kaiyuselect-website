---
import DemoLayout from '../../../components/demos/DemoLayout.astro';
import Art from '../../../components/demos/Art.astro';
import Catalog from '../../../components/demos/Catalog.astro';
import LocalEnquiry from '../../../components/demos/LocalEnquiry.astro';
const items=[
{id:'sol',title:'The Sol ring',category:'Rings',description:'A rounded band and an open, geometric setting. This study explores the relationship between a warm metal tone and a pale central stone.',art:'jewellery-one',views:['jewellery-one-detail','jewellery-one-alternate'],facts:'Design study 01 · Ring concept'},
{id:'arc',title:'The Arc hoops',category:'Earrings',description:'An elongated curve with a simple closure. The concept uses negative space to create a light, restrained silhouette.',art:'jewellery-two',views:['jewellery-two-detail','jewellery-two-alternate'],facts:'Design study 02 · Earring concept'},
{id:'tide',title:'The Tide pendant',category:'Necklaces',description:'A soft oval suspended from an understated chain. A quiet focal point designed as part of the same fictional collection.',art:'jewellery-three',views:['jewellery-three-detail','jewellery-three-alternate'],facts:'Design study 03 · Pendant concept'}];
---
<DemoLayout slug="fine-jewellery">
  <section class="demo-hero d-shell"><div class="hero-copy"><p class="d-kicker">Aurelle / Collection studies</p><h1>Small objects.<br /><em>Lasting meaning.</em></h1><p class="d-lead">A study in light, form and the things we choose to keep close.</p><a class="d-text-button" href="#collections">Explore the collection →</a></div><div class="hero-media"><Art name="jewellery-hero" alt="AI-generated concept image of a pale stone ring on a sculptural cream plinth" eager sizes="100vw" /><p class="art-caption">AI-generated imagery · Fictional collection</p></div></section>
  <section class="d-section d-shell" id="collections"><div class="jewel-statement"><p class="d-kicker">The considered collection</p><h2>A little less.<br />A little more meaning.</h2><p class="d-lead">Explore three related jewellery studies. Select a piece to see its design story and browse its image details.</p></div><Catalog id="jewellery" items={items} categories={['Rings','Earrings','Necklaces']}><a class="d-text-button" href="#bespoke">Discuss a custom concept →</a></Catalog></section>
  <section class="d-section d-shell d-story" id="story"><Art name="jewellery-editorial" alt="AI-generated fictional model wearing minimal gold jewellery" /><div><p class="d-kicker">The brand story / A fictional direction</p><h2>Quietly expressive.<br />Always considered.</h2><p class="d-lead">Aurelle imagines a boutique where the object speaks first.</p><p>The visual language pairs editorial typography with generous space and simple, sculptural forms. A real brand could use this space to share its founder’s story, verified material information and approach to making.</p><p class="demo-note">No materials, sourcing standards, craftsmanship credentials or production capabilities are claimed by this fictional concept.</p></div></section>
  <section class="d-section d-shell"><LocalEnquiry id="bespoke" title="An idea, made personal." kind="custom design enquiry" date={false} options={['A ring concept','An earring concept','A pendant concept','A different idea']} /></section>
  <section class="d-section d-shell" id="questions"><div class="d-faq"><p class="d-kicker">A few thoughtful answers</p><h2>Before you enquire.</h2><details><summary>Can I purchase these pieces?</summary><p>No. These are AI-generated images of fictional jewellery concepts. This demo has no checkout, stock or purchase facility.</p></details><details><summary>How would a custom enquiry work?</summary><p>A real boutique could use a similar form to understand the idea, preferred form and timeline before discussing materials, feasibility and a quote. Here the form only displays a local preview.</p></details><details><summary>Are the materials and dimensions specified?</summary><p>No. The generated images explore a design direction. A real product page would include verified measurements, material specifications, care instructions and availability.</p></details></div></section>
</DemoLayout>
