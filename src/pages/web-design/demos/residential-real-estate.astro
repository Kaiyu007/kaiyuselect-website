---
import DemoLayout from '../../../components/demos/DemoLayout.astro';
import Art from '../../../components/demos/Art.astro';
import Catalog from '../../../components/demos/Catalog.astro';
import LocalEnquiry from '../../../components/demos/LocalEnquiry.astro';
const items=[
{id:'courtyard',title:'The Courtyard House',category:'House',beds:3,art:'property-one',views:['property-one-detail','property-one-alternate'],description:'A fictional single-level house study centred on simple volumes and an outdoor connection. Explore the generated architectural imagery; there is no real property or address attached to this listing.',facts:'3 bedrooms · 2 bathrooms · Concept listing A'},
{id:'verandah',title:'The Verandah Home',category:'House',beds:4,art:'property-two',views:['property-two-detail','property-two-alternate'],description:'A fictional family-home study with a broad verandah and a symmetrical street-facing composition. All listing details are sample data for this interactive demonstration.',facts:'4 bedrooms · 2 bathrooms · Concept listing B'},
{id:'terrace',title:'The Garden Apartment',category:'Apartment',beds:2,art:'property-three',views:['property-three-detail','property-three-alternate'],description:'A fictional garden apartment interior study with natural textures and an outdoor connection. This concept cannot be inspected, purchased or leased.',facts:'2 bedrooms · 1 bathroom · Concept listing C'}];
---
<DemoLayout slug="residential-real-estate">
  <section class="demo-hero d-shell"><div class="hero-copy"><p class="d-kicker">Considered places / Fictional property collection</p><h1>A place for<br />your next chapter.</h1><p class="d-lead">Space to settle. Room to imagine. Explore an fictional collection of residential possibilities.</p><a class="d-text-button" href="#listings">Find your kind of space →</a></div><div class="hero-media"><Art name="property-hero" alt="AI-generated architectural concept of a fictional courtyard house" eager sizes="100vw" /><p class="art-caption">Concept listing / No real address or property offered</p></div></section>
  <section class="d-section d-shell" id="listings"><div class="d-section-head"><div><p class="d-kicker">The collection / Property search</p><h2>Something that feels like home.</h2></div><p>Combine property type and bedroom filters. Select a listing to explore its imagery and sample details.</p></div><Catalog id="property" items={items} categories={['House','Apartment']} property><a class="d-text-button" href="#inspection">Explore an inspection enquiry →</a></Catalog></section>
  <section class="d-section d-shell" id="neighbourhoods"><div class="d-grid-2"><div><p class="d-kicker">A sense of place / Neighbourhood guide</p><h2>Look beyond<br />the front door.</h2><p class="d-lead">Three ways to think about the setting around a home.</p><p class="demo-note">These are lifestyle themes, not real suburb guides. There are no claims about schools, transport, safety, investment returns or local amenities.</p></div><div><article class="neighbourhood"><h3>The garden setting</h3><p>A concept focused on outdoor space, planted edges and room to gather.</p></article><article class="neighbourhood"><h3>The connected setting</h3><p>A way to present a home’s relationship to everyday destinations, supported by verified information in a real listing.</p></article><article class="neighbourhood"><h3>The quieter setting</h3><p>An editorial direction centred on light, space and a considered pace of living.</p></article></div></div></section>
  <section class="d-section d-shell" id="people"><div class="d-section-head"><div><p class="d-kicker">The people / Fictional agent layouts</p><h2>A more personal conversation.</h2></div><p>Role-based profiles show how an agency could introduce its people without fabricated identities or credentials.</p></div><div class="d-grid-3"><article class="d-card"><span class="d-index">01 / Property adviser</span><h3>A guide to the collection.</h3><p>A real profile would include a verified name, role, licence information where required and direct contact details.</p></article><article class="d-card"><span class="d-index">02 / Client liaison</span><h3>Clarity in the next step.</h3><p>A profile focused on enquiries, practical information and coordinating conversations with the appropriate person.</p></article><article class="d-card"><span class="d-index">03 / Inspection coordinator</span><h3>A considered first visit.</h3><p>A clear point of contact for confirmed inspection arrangements. This fictional role does not operate real inspections.</p></article></div></section>
  <section class="d-section d-shell"><LocalEnquiry id="inspection" title="Imagine the first visit." kind="inspection enquiry" options={['The Courtyard House — fictional','The Verandah Home — fictional','The Garden Apartment — fictional']} /></section>
</DemoLayout>
