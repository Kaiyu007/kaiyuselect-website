---
import BaseLayout from '../../../../components/BaseLayout.astro';
import WebsiteScreenshot from '../../../../components/WebsiteScreenshot.astro';
import ContactCta from '../../../../components/ContactCta.astro';
import { websiteEnquiry } from '../../../../data/web-demos';
import images from '../../../../data/website-case-images.json';
const full = (name: keyof typeof images) => images[name].variants.at(-1)!.src;
const social = images['home-desktop'].variants.find(v => v.width === 1200)!;
const sections = [['overview','The brief'],['structure','Structure & design'],['responsive','Responsive delivery'],['enquiries','Online enquiries'],['technology','Technology & deployment'],['delivery','Deliverables & learning']];
---
<BaseLayout title="Kaiyu Select — Business Website Case Study" description="A real, self-owned Kaiyu Select website project: responsive Astro design, a clearly labelled demo portfolio and integrated online enquiries on Cloudflare Pages." image={{src:social.src,width:social.width,height:social.height,alt:'Actual Kaiyu Select production homepage captured in November 2026'}}>
  <header class="page-hero">
    <div class="shell project-hero">
      <a class="text-link project-back" href="/web-design/#live-project">← Web Design portfolio</a>
      <p class="eyebrow"><span></span>Live Website / Self-Owned Project</p>
      <h1>Kaiyu Select —<br /><em>Business Website.</em></h1>
      <p class="project-lead">A working home for a founder-led business: engineering design, website development and selected products, brought together with clear information and practical enquiry paths.</p>
      <div class="project-actions"><a class="button" href="/">Visit the website <span aria-hidden="true">↗</span></a><a class="text-link" href={websiteEnquiry('a website like Kaiyu Select')}>Discuss a similar website <span aria-hidden="true">→</span></a></div>
      <dl class="project-facts"><div><dt>Project relationship</dt><dd>Self-owned business website</dd></div><div><dt>Platform</dt><dd>Astro · Cloudflare Pages</dd></div><div><dt>Project status</dt><dd>Live, with ongoing improvements</dd></div></dl>
    </div>
  </header>

  <section class="section section-white" aria-labelledby="capture-heading">
    <div class="shell">
      <div class="project-section-heading"><p class="eyebrow"><span></span>The actual website</p><h2 id="capture-heading">One identity.<br />Different screen sizes.</h2><p>Real production captures from 9 November 2026. These show the homepage before the three-service wording update; they are dated evidence of the published website, not generated mockups.</p></div>
      <div class="project-captures">
        <figure><a href={full('home-desktop')} aria-label="Open full-size production homepage desktop screenshot"><WebsiteScreenshot name="home-desktop" alt="Actual desktop homepage of Kaiyu Select, captured before the three-service wording update" sizes="(max-width: 720px) calc(100vw - 32px), 70vw" loading="eager" /></a><figcaption>Production homepage · Desktop · 9 November 2026<br /><a href={full('home-desktop')}>View full-size screenshot ↗</a></figcaption></figure>
        <figure class="project-mobile-capture"><a href={full('home-mobile')} aria-label="Open full-size production homepage mobile screenshot"><WebsiteScreenshot name="home-mobile" alt="Actual Kaiyu Select production homepage at mobile width in November 2026" sizes="(max-width: 720px) 240px, 24vw" /></a><figcaption>Production homepage · Mobile<br /><a href={full('home-mobile')}>View full-size screenshot ↗</a></figcaption></figure>
      </div>
    </div>
  </section>

  <div class="shell project-body">
    <nav class="project-contents" aria-label="Case study sections"><p class="eyebrow"><span></span>In this case study</p>{sections.map(([id,label],i)=><a href={`#${id}`}><span>0{i+1}</span>{label}</a>)}</nav>
    <div class="project-story">
      <section id="overview"><p class="eyebrow">01 / The brief</p><h2>A useful business website, with an honest portfolio.</h2><p>Kaiyu Select is a founder-led small business based in Townsville, Queensland. This website is its own operational site, not a commissioned client project. It explains available services, presents selected phone accessories and provides a way to begin a conversation.</p><h3>Business goals</h3><ul><li>Make engineering, website design and product enquiries easy to distinguish.</li><li>Show project evidence and product imagery without inventing results, credentials or stock availability.</li><li>Give visitors a practical next step on desktop and mobile.</li><li>Keep real work separate from illustrative website concepts.</li></ul><p>The project has been developed and refined with AI-assisted coding and visual iteration, followed by automated checks and browser review. It is not presented as entirely hand-coded work or evidence of a larger agency team.</p></section>

      <section id="structure"><p class="eyebrow">02 / Structure & design</p><h2>Clear destinations within one visual identity.</h2><h3>Website structure</h3><p>The <a href="/">homepage</a> introduces the business. <a href="/engineering">Engineering</a> explains service scope, <a href="/products">Products</a> presents photographed accessories and <a href="/projects/">Projects</a> provides engineering evidence. <a href="/web-design/">Web Design</a> brings together this live project and eight separately labelled industry demos. About, Contact, Privacy and Terms support the main pages.</p><h3>Design direction</h3><p>A CSS geometric logo, warm-white backgrounds, dark green, teal, restrained borders and editorial typography connect the main site. Reusable headers, footers, cards and section patterns keep the pages consistent. Authentic engineering and product images remain part of their respective business areas.</p><figure class="project-portfolio-capture"><a href={full('portfolio-desktop')} aria-label="Open full-size published Web Design portfolio screenshot"><WebsiteScreenshot name="portfolio-desktop" alt="Actual published Web Design portfolio showing clearly labelled fictional automotive and jewellery concepts" sizes="(max-width: 720px) calc(100vw - 32px), 62vw" /></a><figcaption>Published portfolio capture · 9 November 2026. The eight industry concepts use disclosed AI-generated imagery and simulated interactions; they are not paid client projects.</figcaption></figure></section>

      <section id="responsive"><p class="eyebrow">03 / Responsive delivery</p><h2>Built to be read and used across screens.</h2><p>Responsive grids, a mobile menu, flexible typography and explicit image dimensions adapt the content to smaller screens. Images use responsive sources and lazy loading where appropriate, while keyboard focus and native controls support navigation and form use.</p><p>Review covers desktop, laptop, tablet and narrow mobile widths, including 1440, 1024, 768, 390, 375 and 360 pixels. Checks look for clipping, horizontal overflow, awkward spacing and interaction regressions. These are implementation checks, not a claim of a formal accessibility certification.</p></section>

      <section id="enquiries"><p class="eyebrow">04 / Online enquiries</p><h2>A direct enquiry path, with useful alternatives.</h2><p>The Contact page supports engineering, project, product, wholesale, website design and general enquiries. Links can preselect a category and subject so the visitor keeps the context of the page they came from. Website enquiries include optional planning guidance without requiring a budget.</p><p>The deployed enquiry system uses a Cloudflare Pages Function for server-side validation, Cloudflare Turnstile for spam verification and Resend for email delivery. Cloudflare KV and the existing WAF rule provide rate controls. A fixed recipient and plain-text messages keep the delivery path defined.</p><p>Email preparation and copy options remain available. The interface distinguishes acceptance for delivery from a promise that a message reached an inbox, and handles failed requests without discarding the visitor’s text. The industry demo forms remain isolated local simulations.</p><a class="text-link" href={websiteEnquiry('Kaiyu Select case study enquiry')}>Discuss your website <span aria-hidden="true">→</span></a></section>

      <section id="technology"><p class="eyebrow">05 / Technology & deployment</p><h2>A maintainable static foundation.</h2><dl class="project-technical"><div><dt>Website</dt><dd>Astro, reusable components, CSS and focused TypeScript interactions. The November 2026 production release uses Astro 7.4.7.</dd></div><div><dt>Hosting</dt><dd>Cloudflare Pages, connected to the existing GitHub repository and production branch for automated builds.</dd></div><div><dt>Enquiry backend</dt><dd>A native Pages Function, Turnstile validation, Resend and a KV binding. Credentials remain server-side.</dd></div><div><dt>Search & sharing</dt><dd>Page-specific metadata, canonical URLs, social metadata and a maintained sitemap.</dd></div></dl><h3>Technical considerations</h3><p>Function routing is limited to the enquiry endpoint. Same-origin checks, bounded inputs, server-side validation and idempotency handling protect the submission flow. The www hostname redirects to the canonical apex domain while preserving navigation context.</p><p>Optimised image variants keep high-resolution authoring files out of the public build. Production changes are reviewed, built and verified before release, with a previously healthy deployment recorded for rollback.</p></section>

      <section id="delivery"><p class="eyebrow">06 / Deliverables & learning</p><h2>A working foundation that can keep improving.</h2><h3>Actual deliverables</h3><ul><li>A responsive business website with Engineering, Products, Projects, About and Contact pages.</li><li>A Web Design service portfolio and eight independent, interactive fictional demo websites.</li><li>Integrated online enquiries with email and copy alternatives.</li><li>Reusable components, optimised assets, metadata and validation scripts in version control.</li><li>A documented deployment and rollback process for the existing production site.</li></ul><h3>Lessons and ongoing improvements</h3><p>New services need to appear consistently in the business introduction, enquiry categories and portfolio. A canonical hostname matters when the backend validates request origins. Clear labels and dated screenshots help separate operational work from demonstration content.</p><p>Ongoing work includes reviewing content as the business develops, maintaining dependencies and checking changes across screen sizes. No traffic figures, conversion gains, customer testimonials or commercial outcomes are claimed for this case study.</p></section>
    </div>
  </div>
  <ContactCta eyebrow="A website for your business" heading="Start with what your website needs to do." text="Share your business, audience and the features you have in mind. We can discuss a suitable scope and the next step." href={websiteEnquiry('a website like Kaiyu Select')} />
</BaseLayout>
<style>
.project-hero{max-width:var(--max)}.project-back{font-size:12px;margin-bottom:34px}.project-hero h1{font-size:clamp(2.6rem,5.2vw,4.8rem);max-width:950px;line-height:1.08;margin-bottom:24px}.project-hero h1 em{color:var(--teal);font-style:normal}.project-lead{max-width:760px;color:var(--muted);font-size:19px}.project-actions{display:flex;align-items:center;gap:24px;flex-wrap:wrap;margin-top:28px}.project-facts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:1px solid var(--line);margin:48px 0 0;padding-top:26px;gap:24px}.project-facts dt{color:var(--teal);font-size:10px;letter-spacing:.12em;text-transform:uppercase;font-weight:750;margin-bottom:9px}.project-facts dd{font-size:14px;margin:0}.project-section-heading{max-width:760px;margin-bottom:36px}.project-section-heading>p:last-child{color:var(--muted);font-size:14px}.project-captures{display:grid;grid-template-columns:minmax(0,3.4fr) minmax(0,1fr);gap:32px;align-items:end}figure{margin:0}figure>a{display:block;border:1px solid var(--line);background:var(--paper)}figure :global(img){display:block;width:100%;height:auto}figcaption{font-size:12px;color:var(--muted);line-height:1.6;margin-top:14px}figcaption a{color:var(--teal);text-underline-offset:3px}.project-body{display:grid;grid-template-columns:240px minmax(0,1fr);gap:72px;padding-block:var(--section-space)}.project-contents{align-self:start;position:sticky;top:30px}.project-contents .eyebrow{font-size:10px}.project-contents>a{display:flex;gap:16px;padding:14px 0;border-bottom:1px solid var(--line);text-decoration:none;font-size:13px}.project-contents>a span{color:var(--teal);font:11px ui-monospace,monospace}.project-contents>a:hover{color:var(--teal)}.project-story{min-width:0}.project-story section{scroll-margin-top:30px}.project-story section+section{margin-top:60px;padding-top:48px;border-top:1px solid var(--line)}.project-story h2{font-size:clamp(2rem,3.2vw,2.8rem);max-width:760px}.project-story h3{font-size:19px;margin-top:30px}.project-story p,.project-story li,.project-technical dd{font-size:15px;color:var(--muted);line-height:1.8}.project-story p>a{color:var(--teal);text-underline-offset:3px}.project-story ul{padding-left:20px}.project-story li{padding-left:4px;margin-bottom:10px}.project-portfolio-capture{margin-block:32px}.project-technical{margin:28px 0}.project-technical>div{display:grid;grid-template-columns:145px minmax(0,1fr);gap:24px;border-top:1px solid var(--line);padding:20px 0}.project-technical dt{font-size:13px;font-weight:700}.project-technical dd{margin:0}
@media(max-width:1000px){.project-body{grid-template-columns:180px minmax(0,1fr);gap:40px}.project-technical>div{grid-template-columns:1fr;gap:8px}}
@media(max-width:720px){.project-hero h1{font-size:2.6rem}.project-lead{font-size:17px}.project-actions{align-items:flex-start;gap:20px}.project-facts{grid-template-columns:1fr;margin-top:32px;gap:18px}.project-facts>div{display:grid;grid-template-columns:125px minmax(0,1fr);gap:16px}.project-facts dt{margin:0}.project-captures{grid-template-columns:1fr;gap:30px}.project-mobile-capture{width:240px;max-width:100%;margin-inline:auto}.project-body{grid-template-columns:1fr;gap:40px}.project-contents{position:static}.project-contents>a{padding:12px 0}.project-story section+section{margin-top:40px;padding-top:36px}.project-story h2{font-size:2rem}.project-back{margin-bottom:26px}}
</style>
