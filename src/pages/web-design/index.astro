---
import BaseLayout from '../../components/BaseLayout.astro';
import WebsiteScreenshot from '../../components/WebsiteScreenshot.astro';
import WebsitePricing from '../../components/WebsitePricing.astro';
import { demos, demoHref, websiteEnquiry } from '../../data/web-demos';
---
<BaseLayout title="Web Design for Small Businesses | Kaiyu Select" description="Compare five website design packages in AUD for Australian small businesses. Explore the real Kaiyu Select website and eight interactive industry demo concepts.">
  <header class="web-hero shell">
    <div><p class="eyebrow"><span></span>Web Design by Kaiyu Select</p><h1>A considered website.<br /><em>A clearer first impression.</em></h1><p class="web-lead">Practical, distinctive websites that help people understand your business and take the next step.</p><div class="hero-actions"><a class="button" href="#live-project">Explore the portfolio <span aria-hidden="true">↓</span></a><a class="button button-outline" href={websiteEnquiry('a new business website')}>Discuss a website <span aria-hidden="true">↗</span></a></div><a class="text-link hero-pricing-link" href="#pricing">View Pricing <span aria-hidden="true">↓</span></a></div>
    <div class="web-intro-note"><span class="web-large-number">08</span><p>Industries. Individual design directions.<br />Working interactions to explore.</p><small>Original fictional concepts — not commissioned client work.</small></div>
  </header>
  <section class="section section-white"><div class="shell"><div class="section-heading split"><div><p class="eyebrow"><span></span>Built around your business</p><h2>Clear content.<br />Useful interactions.</h2></div><p class="section-intro">For trades, professional services, boutiques, cafés, studios and other small businesses that need a coherent online presence. Scope, content and integrations are agreed before development.</p></div><div class="web-services">
    <article><span>01 / Structure</span><h3>Content & direction</h3><p>Page planning, a clear customer journey and a visual direction that works with your existing identity.</p></article>
    <article><span>02 / Design</span><h3>Responsive websites</h3><p>Custom layouts, accessible navigation and considered typography across desktop, tablet and mobile.</p></article>
    <article><span>03 / Development</span><h3>Purposeful features</h3><p>Service pages, filterable galleries, product showcases and enquiry pathways suited to the agreed scope.</p></article>
    <article><span>04 / Handover</span><h3>A practical foundation</h3><p>Performance checks, page metadata, browser review and guidance for maintaining your content. Hosting and ongoing support are discussed separately.</p></article>
  </div></div></section>
  <WebsitePricing />
  <section class="section" id="live-project" aria-labelledby="live-project-title"><div class="shell"><div class="section-heading split"><div><p class="eyebrow"><span></span>Real Website Project</p><h2 id="live-project-title">A working website.<br />Our own business.</h2></div><p class="section-intro">A live, self-owned project with real business content and an operational enquiry system. Presented separately from the fictional industry concepts below.</p></div><article class="live-project-card"><a class="live-project-image" href="/web-design/projects/kaiyu-select/" aria-label="View the Kaiyu Select real website case study"><WebsiteScreenshot name="home-desktop" alt="Actual Kaiyu Select production homepage, captured on 9 November 2026" sizes="(max-width: 900px) calc(100vw - 32px), 58vw" /></a><div class="live-project-copy"><p class="eyebrow">Live Website / Self-Owned Project</p><h3><a href="/web-design/projects/kaiyu-select/">Kaiyu Select —<br />Business Website</a></h3><p>Responsive service and product pages, an independent demo portfolio, and online enquiries built on Astro and Cloudflare Pages.</p><p class="capture-note">Actual production screenshot · 9 November 2026, before the three-service wording update.</p><a class="text-link" href="/web-design/projects/kaiyu-select/">View the case study <span aria-hidden="true">→</span></a></div></article></div></section>
  <section class="section" id="concepts"><div class="shell"><div class="section-heading split"><div><p class="eyebrow"><span></span>Industry Demo Concepts</p><h2>Eight businesses.<br />Eight different experiences.</h2></div><p class="section-intro">Open each concept to try its navigation and industry-specific features. All brands, listings and sample content are fictional. Photorealistic AI-generated imagery illustrates the concepts; it does not depict real client work.</p></div>
    <div class="web-demo-grid">{demos.map(d=><article class={`web-demo-card preview-${d.theme}`}><a class="web-card-visual" href={demoHref(d.slug)} aria-label={`Explore ${d.title} demo`}><div class="preview-browser" aria-hidden="true"><i></i><i></i><i></i><span>{d.brand}</span></div><img class="demo-page-preview" src={`/images/web-design/previews/${d.slug}-800.webp`} srcset={`/images/web-design/previews/${d.slug}-480.webp 480w, /images/web-design/previews/${d.slug}-800.webp 800w, /images/web-design/previews/${d.slug}-1200.webp 1200w`} sizes="(max-width: 720px) calc(100vw - 36px), (max-width: 1280px) 46vw, 590px" alt={`Actual desktop screenshot of the ${d.title} interactive demo`} width="1425" height="990" loading="lazy" decoding="async" /></a><div class="web-card-copy"><p class="eyebrow">{d.number} / Fictional demo concept</p><h3><a href={demoHref(d.slug)}>{d.title}</a></h3><p>{d.summary}</p><ul>{d.features.map(f=><li>{f}</li>)}</ul><a class="text-link" href={demoHref(d.slug)}>Explore interactive demo <span aria-hidden="true">↗</span></a></div></article>)}</div>
  </div></section>
  <section class="section section-white"><div class="shell web-scope"><div><p class="eyebrow"><span></span>From concept to your website</p><h2>The right details<br />for your real business.</h2></div><div><p>These concepts show possible design directions. Choose a published package or discuss a tailored scope based on your audience, the content you can provide and the features you need.</p><p>Booking and online store options follow the package limits above, with platform capabilities and third-party costs confirmed before a project is accepted. The demos do not process bookings, orders or enquiries.</p><a class="button" href={websiteEnquiry('Web Design consultation')}>Tell us about your website <span aria-hidden="true">↗</span></a></div></div></section>
</BaseLayout>
<style>
  .hero-pricing-link{margin-top:22px;min-height:44px;display:inline-flex;align-items:center}
  .live-project-card{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr);border:1px solid var(--line);background:var(--white)}.live-project-image{display:block;align-self:center}.live-project-image :global(img){display:block;width:100%;height:auto}.live-project-copy{padding:40px;display:flex;flex-direction:column;justify-content:center}.live-project-copy h3{font-size:32px}.live-project-copy h3 a{text-decoration:none}.live-project-copy>p:not(.eyebrow){font-size:15px;color:var(--muted)}.live-project-copy .eyebrow{font-size:10px;letter-spacing:.08em}.live-project-copy>.capture-note{font-size:12px!important}.live-project-copy>.text-link{align-self:flex-start;margin-top:10px}@media(max-width:900px){.live-project-card{grid-template-columns:1fr}.live-project-copy{padding:28px}.live-project-image{border-bottom:1px solid var(--line)}}@media(max-width:720px){.live-project-copy{padding:24px}.live-project-copy h3{font-size:28px}}
  .web-hero{display:grid;grid-template-columns:1.6fr .6fr;gap:70px;padding-block:80px;align-items:end}.web-hero h1{font-size:clamp(2.8rem,4.8vw,4.6rem);line-height:1.08}.web-hero h1 em{font-style:normal;color:var(--teal)}.web-lead{font-size:19px;color:var(--muted);max-width:610px}.web-intro-note{border-left:1px solid var(--line);padding:20px 0 20px 36px}.web-large-number{font:400 100px/1.1 Georgia,serif;color:var(--teal)}.web-intro-note p{margin:20px 0;font-size:14px}.web-intro-note small{font-size:12px;color:var(--muted)}.web-services{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line)}.web-services article{padding:30px 25px 10px 0}.web-services article+article{border-left:1px solid var(--line);padding-left:25px}.web-services span{font:11px monospace;color:var(--teal)}.web-services h3{margin-top:25px}.web-services p{font-size:14px;color:var(--muted)}.web-demo-grid{display:grid;grid-template-columns:1fr 1fr;gap:42px 32px}.web-demo-card{border:1px solid var(--line);background:#fff;min-width:0}.web-card-visual{display:block;text-decoration:none;border-bottom:1px solid var(--line);overflow:hidden}.preview-browser{display:flex;gap:5px;align-items:center;padding:13px 17px;background:#fff;color:#60706d;font:10px Arial,sans-serif;letter-spacing:.12em}.preview-browser i{width:5px;height:5px;border:1px solid #a5b1aa;border-radius:50%}.preview-browser span{margin-left:auto}.demo-page-preview{display:block;width:100%;height:auto;aspect-ratio:1.44;object-fit:cover;object-position:top}.web-demo-card{display:flex;flex-direction:column}.web-card-copy{flex:1;display:flex;flex-direction:column}.web-card-copy>.text-link{margin-top:auto;align-self:flex-start}.web-card-copy{padding:30px}.web-card-copy .eyebrow{font-size:10px;margin-bottom:15px}.web-card-copy h3{font-size:27px;margin-bottom:15px}.web-card-copy h3 a{text-decoration:none}.web-card-copy>p:not(.eyebrow){font-size:14px;color:var(--muted)}.web-card-copy ul{list-style:none;display:flex;gap:8px;flex-wrap:wrap;padding:0;margin:20px 0 26px}.web-card-copy li{font-size:10px;background:var(--paper);border:1px solid var(--line);padding:5px 8px}.web-scope{display:grid;grid-template-columns:1fr 1fr;gap:72px}.web-scope>div>p:not(.eyebrow){color:var(--muted)}
  @media(max-width:1000px){.web-hero{gap:35px;grid-template-columns:1.5fr .7fr}.web-card-copy{padding:24px}.web-services{grid-template-columns:1fr 1fr}.web-services article:nth-child(3){border-left:0;padding-left:0}.web-services article:nth-child(n+3){border-top:1px solid var(--line)}}
  @media(max-width:720px){.web-hero{grid-template-columns:1fr;gap:30px;padding-block:48px}.web-hero h1{font-size:2.8rem}.web-lead{font-size:17px}.web-intro-note{display:grid;grid-template-columns:auto 1fr;gap:8px 24px;border-left:0;border-top:1px solid var(--line);padding:24px 0 0}.web-large-number{font-size:65px;grid-row:span 2}.web-intro-note p{margin:0;font-size:13px}.web-intro-note small{font-size:11px}.web-demo-grid{grid-template-columns:1fr;gap:28px}.web-card-copy h3{font-size:25px}.web-services{grid-template-columns:1fr}.web-services article,.web-services article+article{border-left:0;padding:24px 0 10px;border-top:1px solid var(--line)}.web-services article:first-child{border-top:0}.web-services h3{margin-top:16px}.web-scope{grid-template-columns:1fr;gap:24px}.web-scope h2{margin-bottom:0}}
</style>
