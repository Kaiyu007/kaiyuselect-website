---
import BaseLayout from '../components/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { featuredProject, projects } from '../data/site';

const caseStudySteps = [
  { number: '01', title: 'Brief', description: 'The objective, constraints and available reference information.' },
  { number: '02', title: 'Development', description: 'The modelling, design decisions and revision process.' },
  { number: '03', title: 'Technical Output', description: 'The drawings, CAD files, analysis or prototype preparation completed.' },
  { number: '04', title: 'Results & limitations', description: 'Documented outcomes, individual contribution and the limits of the available evidence.' },
];
---

<BaseLayout title="Engineering Projects & CAD Portfolio | Kaiyu Select" description="Explore a documented Electric Postie Bike academic case study and authentic CAD, mechanical design and preliminary analysis visuals from Kaiyu Select.">
  <header class="page-hero engineering-hero projects-hero">
    <div class="shell page-hero-grid engineering-hero-grid">
      <div>
        <p class="eyebrow"><span></span>Engineering Portfolio</p>
        <h1>Selected Engineering Projects</h1>
      </div>
      <div class="page-hero-copy engineering-hero-copy">
        <p>Explore the design process through a documented academic project and selected technical visuals. Each entry makes the available evidence and its context clear.</p>
        <div class="engineering-hero-actions">
          <a class="button" href="#project-grid">Explore Projects <span aria-hidden="true">↓</span></a>
          <a class="button button-outline" href="/contact/?type=project">Discuss a Project <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </header>

  <section class="section section-white projects-portfolio-section" id="project-grid">
    <div class="shell">
      <SectionHeading eyebrow="Documented case study" heading="From concept to a virtual assembly." intro="A completed academic group project, with CAD development, technical visuals and a clearly defined individual contribution." align="split" />

      <div class="featured-project">
        <ProjectCard {...featuredProject} />
      </div>

      <div class="portfolio-gallery-heading"><p class="eyebrow"><span></span>Technical image gallery</p><h2>Selected models and design studies.</h2><p>These authentic engineering visuals show areas of work. Their full case studies, contribution details and outcomes are still being prepared; they are not presented as completed client engagements.</p></div>
      <div class="project-grid">
        {projects.map((project) => <ProjectCard {...project} />)}
      </div>
    </div>
  </section>

  <section class="section section-dark projects-process-section" aria-labelledby="projects-process-heading">
    <div class="shell">
      <SectionHeading id="projects-process-heading" eyebrow="What Each Case Study Will Show" heading="From requirements to final deliverables." />
      <div class="process-grid projects-process-grid">
        {caseStudySteps.map((step) => (
          <article class="process-step">
            <span>{step.number}</span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="contact-cta" aria-labelledby="projects-cta-heading">
    <div class="shell contact-cta-inner">
      <div>
        <p class="eyebrow light"><span></span>Your Project</p>
        <h2 id="projects-cta-heading">Have a design problem or project idea?</h2>
      </div>
      <div>
        <p>Share the current stage, available files and intended outcome to receive a practical next step.</p>
        <a class="button button-light" href="/contact/?type=project">Discuss Your Project <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
