---
import BaseLayout from '../components/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ContactCta from '../components/ContactCta.astro';
import { founderBackground } from '../data/business';
---
<BaseLayout title="About Kaiyu Select | Founder-led Business in Townsville" description="Meet Kaiyu Select, a founder-led small business in Townsville, Queensland, offering engineering design and CAD, website design and development, and selected phone accessories.">
  <header class="page-hero">
    <div class="shell page-hero-grid">
      <div><p class="eyebrow"><span></span>About Kaiyu Select</p><h1>Practical thinking.<br />Personal attention.</h1></div>
      <div class="page-hero-copy"><p>A founder-led Australian small business operating in Townsville, Queensland. Engineering design and CAD, website design and development, and selected everyday products — approached with care and clear communication.</p></div>
    </div>
  </header>
  <section class="section section-white">
    <div class="shell story-grid">
      <div><p class="eyebrow"><span></span>One business, three directions</p><h2>Useful design, on screen and in everyday life.</h2></div>
      <div class="story-copy">
        <p class="lead">Kaiyu Select brings a practical approach to engineering work, business websites and product selection.</p>
        <p>Engineering services help individuals, makers, students, start-ups and small businesses turn sketches, measurements and requirements into CAD models, product designs and clear technical drawings.</p>
        <p>Website design helps small businesses explain what they offer and make the next step clear. Work includes responsive layouts, service and product pages, and enquiry pathways agreed to suit the business. The website portfolio separates the live Kaiyu Select project from fictional industry concepts.</p>
        <p>The retail side focuses on selected phone accessories. Local market sales of phone cases in Townsville have already begun; current styles, fit and availability are confirmed directly.</p>
        <p>As a small, founder-led business, the focus is on manageable project scopes, direct communication and realistic expectations.</p>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="shell about-directions">
      <article><p class="eyebrow"><span></span>Engineering capability</p><h2>Clear files. Defined scope.</h2><p>3D CAD modelling, technical drawings, product development and prototyping support. The portfolio includes a documented academic group project, with the individual contribution clearly identified.</p><a class="text-link" href="/projects">Explore engineering work <span aria-hidden="true">→</span></a></article>
      <article><p class="eyebrow"><span></span>Website design</p><h2>Clear content. Useful interactions.</h2><p>Responsive websites with practical navigation and a considered visual direction. Explore the self-owned business website and eight interactive fictional concepts, each clearly labelled.</p><a class="text-link" href="/web-design/">Explore website work <span aria-hidden="true">→</span></a></article>
      <article><p class="eyebrow"><span></span>Local product business</p><h2>Everyday function. Considered choices.</h2><p>Phone cases and ring-stand accessories for individual customers, with product and bulk-purchase enquiries welcome from local Australian retailers and small businesses.</p><a class="text-link" href="/products">View selected products <span aria-hidden="true">→</span></a></article>
    </div>
  </section>
  {founderBackground.approved && founderBackground.text && <section class="section section-white"><div class="shell story-grid"><h2>{founderBackground.heading}</h2><div class="story-copy"><p>{founderBackground.text}</p></div></div></section>}
  <section class="section section-dark">
    <div class="shell">
      <SectionHeading eyebrow="Working principles" heading="Small business. Clear commitments." />
      <div class="principles-grid">
        <article class="principle"><span>01</span><h3>Practical first</h3><p>Function, constraints and the real use case guide decisions.</p></article>
        <article class="principle"><span>02</span><h3>Clear communication</h3><p>Agree the scope and intended deliverables before engineering or website work begins. Confirm product details before a purchase.</p></article>
        <article class="principle"><span>03</span><h3>Honest expectations</h3><p>Be clear about available information, current product availability and the limits of preliminary engineering analysis.</p></article>
      </div>
    </div>
  </section>
  <ContactCta eyebrow="Based in Townsville, Queensland" heading="Start with a practical conversation." text="Share your project, product question or business enquiry. Service scope and any delivery or collection arrangements are confirmed directly." />
</BaseLayout>

<style>
.about-directions{grid-template-columns:repeat(3,minmax(0,1fr));gap:32px}.about-directions article+article{border-left:1px solid var(--line);padding-left:32px}.about-directions h2{font-size:clamp(1.65rem,2.6vw,2.25rem)}.about-directions .text-link{font-size:13px}.about-directions .eyebrow{font-size:10px;letter-spacing:.1em}@media(max-width:900px){.about-directions{grid-template-columns:1fr;gap:32px}.about-directions article+article{border-left:0;border-top:1px solid var(--line);padding:28px 0 0}.about-directions h2{font-size:2rem}}
</style>
