---
import BaseLayout from '../components/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProductCard from '../components/ProductCard.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import ContactCta from '../components/ContactCta.astro';
import { featuredProducts, consideredCategories } from '../data/site';
---
<BaseLayout title="Phone Cases & Selected Products in Townsville | Kaiyu Select" description="Explore Kaiyu Select phone cases and ring-stand accessories. Ask about fit, colours, availability and wholesale opportunities from our Townsville small business.">
  <header class="page-hero">
    <div class="shell page-hero-grid">
      <div><p class="eyebrow"><span></span>Division 02 · Products</p><h1 class="product-hero-title">Useful products,<br />carefully selected.</h1></div>
      <div class="page-hero-copy"><p>Phone accessories with a focus on everyday function. Kaiyu Select has sold phone cases at local markets in Townsville, Queensland.</p><p class="hero-supporting-copy">Browse the styles below, then ask about your phone model, colour and current availability.</p></div>
    </div>
    <nav class="shell section-nav" aria-label="Product sections"><a href="#collection">Product collection <span aria-hidden="true">↓</span></a><a href="#wholesale">Wholesale &amp; retail <span aria-hidden="true">↓</span></a><a href="#coming-soon">Future categories <span aria-hidden="true">↓</span></a></nav>
  </header>
  <section class="section section-white" id="collection" aria-labelledby="collection-heading">
    <div class="shell">
      <SectionHeading id="collection-heading" eyebrow="Product collection" heading="Find a style. Check the fit." intro="Authentic photographs of selected phone cases. Availability and compatible phone models are confirmed by enquiry; photographs do not indicate current stock." align="split" />
      <div class="products-grid">{featuredProducts.map(product => <ProductCard {...product} />)}</div>
      <p class="collection-note">Looking for a different colour or phone model? <a href="/contact?type=product">Send a product enquiry</a>. Prices and fulfilment options are confirmed directly.</p>
    </div>
  </section>
  <section class="section">
    <div class="shell product-detail">
      <div class="product-detail-media"><ResponsiveImage src="/images/products/purple-ring-stand-open.jpg" alt="Purple phone case standing upright with its circular ring stand open" /></div>
      <div class="product-detail-copy">
        <p class="eyebrow"><span></span>Functional detail</p>
        <h2>Built-in support when you need it.</h2>
        <p class="lead">The integrated ring opens to support hands-free viewing and folds back into the case when not in use.</p>
        <p>A simple feature with a clear everyday purpose. Ask about the ring-stand styles available for your phone model.</p>
        <a class="text-link" href="/contact?type=product&amp;subject=Ring-stand%20cases">Ask about ring-stand cases <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
  <section class="section section-dark" id="wholesale" aria-labelledby="wholesale-heading">
    <div class="shell wholesale-grid">
      <div><p class="eyebrow"><span></span>Wholesale &amp; retail enquiries</p><h2 id="wholesale-heading">A conversation for your business.</h2><p class="section-intro">Local Australian retailers and small businesses are welcome to discuss bulk purchasing, product categories and potential supply opportunities.</p></div>
      <div class="wholesale-details"><h3>Tell us what you are looking for.</h3><ul><li>Your business and location</li><li>Product categories or styles of interest</li><li>Indicative quantities and preferred timing</li></ul><p>Availability, pricing and any supply arrangements are discussed individually.</p><a class="button button-light" href="/contact?type=wholesale&amp;subject=Wholesale%20and%20retail%20enquiry">Make a business enquiry <span aria-hidden="true">↗</span></a></div>
    </div>
  </section>
  <section class="section section-white" id="coming-soon" aria-labelledby="coming-soon-heading">
    <div class="shell">
      <SectionHeading id="coming-soon-heading" eyebrow="Looking ahead" heading="Future categories under consideration." intro="These categories are being considered for the future. They are separate from the photographed phone-case collection, with no confirmed launch dates or availability." align="split" />
      <div class="future-categories">{consideredCategories.map(category => <article><span class="availability-label">Under consideration</span><h3>{category.title}</h3><p>{category.description}</p></article>)}</div>
    </div>
  </section>
  <ContactCta eyebrow="Product enquiries" heading="Let’s find the right fit." text="Tell us your phone model and the style you are interested in. We will confirm the available options before you decide." href="/contact?type=product" />
</BaseLayout>
