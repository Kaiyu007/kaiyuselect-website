---
import BaseLayout from '../components/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ContactCta from '../components/ContactCta.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { services } from '../data/site';

---

<BaseLayout title="Kaiyu Select | Engineering Design & Selected Products Australia" description="Kaiyu Select is an Australian small business offering practical engineering design, CAD modelling, product design support and selected everyday products.">
  <section class="hero">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow"><span></span>Engineering + everyday utility</p>
        <h1>Engineering Ideas.<br /><em>Selected Products.</em></h1>
        <p class="hero-description">Engineering design and CAD support, alongside selected phone accessories. A founder-led small business operating in Townsville, Queensland.</p>
        <div class="hero-actions">
          <a class="button" href="/engineering">Explore Engineering Services <span aria-hidden="true">↗</span></a>
          <a class="button button-outline" href="/products">Browse Selected Products</a>
        </div>
        <div class="hero-secondary-links"><a class="text-link" href="/projects">View engineering projects <span aria-hidden="true">→</span></a><a class="text-link" href="/contact">Make an enquiry <span aria-hidden="true">→</span></a></div>
      </div>
      <div class="hero-graphic" aria-hidden="true">
        <span class="graphic-label label-one">Design / Select / Refine</span>
        <div class="tech-orbit"><i class="axis-x"></i><i class="axis-y"></i><i class="node n1"></i><i class="node n2"></i><i class="node n3"></i></div>
        <span class="graphic-label label-two">
          <span>Based in Townsville, Queensland</span>
          <span>Engineering services + selected products</span>
        </span>
      </div>
    </div>
  </section>

  <section class="division-strip" aria-label="Our divisions">
    <div class="shell division-grid">
      <a class="division-card" href="/engineering">
        <span class="number">01</span>
        <div><h2>Engineering Services</h2><p>CAD modelling, product design support, manufacturing-ready drawings and practical project consultation.</p></div>
        <span class="arrow" aria-hidden="true">↗</span>
      </a>
      <a class="division-card" href="/products">
        <span class="number">02</span>
        <div><h2>Selected Products</h2><p>Phone cases and ring-stand accessories, with local market sales in Townsville. Enquire about current options and availability.</p></div>
        <span class="arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionHeading eyebrow="Engineering services" heading="Practical engineering support from idea to usable design files." intro="2D and 3D CAD, product development, technical drawings and prototyping support for individuals and small organisations." align="split" />
      <div class="services-grid">
        {services.slice(0, 4).map((service) => <ServiceCard {...service} />)}
      </div>
      <div class="section-action home-service-links">
        <a class="text-link" href="/engineering">Explore all services <span aria-hidden="true">→</span></a>
        <a class="text-link home-service-secondary-link" href="/projects">View Projects <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section section-white">
    <div class="shell">
      <SectionHeading eyebrow="Selected products" heading="Useful by design. Selected with purpose." intro="Phone cases with a practical focus. Explore the collection, check your phone model and ask about current availability." align="split" />
      <div class="home-product-feature">
        <div class="home-product-media">
          <ResponsiveImage src="/images/products/pastel-ripple-case-lifestyle.jpg" alt="Three pastel ripple-pattern phone cases held in a lifestyle setting" />
        </div>
        <div class="home-product-copy">
          <p class="product-category">Selected phone accessories</p>
          <h3>Colour, texture and everyday function.</h3>
          <p>Kaiyu Select has sold phone cases at local markets in Townsville. Browse the photographed styles and enquire about colours, fit and availability before choosing.</p>
          <span class="status">Availability by enquiry</span>
          <a class="button" href="/products">Browse Selected Products <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </section>

  <ContactCta />
</BaseLayout>
